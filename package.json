{
  "name": "huazhou-markdown-editor",
  "version": "1.0.0",
  "description": "A modern Markdown desktop editor built with Electron",
  "main": "dist/main.js",
  "author": "Huazhou Technology",
  "license": "MIT",
  "scripts": {
    "compile": "tsc && copyfiles src/preload.ts distRenderer && tsc -p tsconfig.preload.json && tsc -p tsconfig.main.json && vite build && copyfiles src/editor.css distRenderer",
    "compile:main": "tsc -p tsconfig.main.json && copyfiles src/preload.ts distRenderer && tsc -p tsconfig.preload.json",
    "watch": "vite build --watch",
    "dev:renderer": "vite",
    "dev": "npm run compile:main && vite build && copyfiles src/index.vue.html dist/index.html && electron . --dev",
    "start": "npm run compile && electron .",
    "build:renderer": "vite build && copyfiles src/index.vue.html dist/index.html",
    "build:win": "npm run compile && electron-builder --win",
    "build:mac": "npm run compile && electron-builder --mac",
    "build:linux": "npm run compile && electron-builder --linux"
  },
  "build": {
    "appId": "com.huazhou.markdown-editor",
    "productName": "花洲 Markdown 编辑器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "distRenderer/**/*",
      "resources/**/*",
      "src/editor.css"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "codemirror": "^5.65.16",
    "marked": "^12.0.0",
    "vite": "^5.4.21",
    "vue": "^3.5.28",
    "vue-tsc": "^3.2.4"
  },
  "devDependencies": {
    "@types/codemirror": "^5.60.17",
    "@types/marked": "^5.0.2",
    "@types/node": "^25.2.3",
    "copyfiles": "^2.4.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
