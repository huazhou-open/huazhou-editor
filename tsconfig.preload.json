{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "distRenderer",
    "rootDir": "src",
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "include": ["src/preload.ts"],
  "exclude": ["node_modules", "dist", "distRenderer", "src/renderer", "src/index.vue.html"]
}
